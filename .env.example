# Clearvest Environment Configuration Example
# Copy to .env and supply environment-specific credentials

APP_ENV=development
PORT=3000

# Security & Sessions (Must be a 32+ character random secret in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/clearvest_dev?schema=public
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/clearvest_test?schema=public

# Feature & Regulatory Modes
DEMO_MODE=true
MARKET_DATA_MODE=simulated
MARKET_DATA_PROVIDER=simulated
ACCOUNT_AGGREGATION_MODE=sandbox
BROKERAGE_MODE=sandbox
PERSONALIZED_ADVICE_MODE=disabled
AI_PROVIDER=grounded_local
